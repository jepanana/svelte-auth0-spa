{
  "openapi": "3.1.0",
  "info": {
    "title": "svelte-auth0-spa API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/me": {
      "get": {
        "summary": "Me",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResult"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LogoutResult": {
        "properties": {
          "logged_out": {
            "type": "boolean",
            "title": "Logged Out"
          }
        },
        "type": "object",
        "required": [
          "logged_out"
        ],
        "title": "LogoutResult"
      },
      "Me": {
        "properties": {
          "sub": {
            "type": "string",
            "title": "Sub"
          },
          "iss": {
            "type": "string",
            "title": "Iss"
          },
          "aud": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Aud"
          },
          "exp": {
            "type": "integer",
            "title": "Exp"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "sub",
          "iss",
          "aud",
          "exp"
        ],
        "title": "Me"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
